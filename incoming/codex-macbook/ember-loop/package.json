{
  "name": "ember-loop-preview",
  "private": true,
  "version": "1.0.0",
  "description": "Preview harness for the self-contained EMBER LOOP HTML file",
  "scripts": {
    "dev": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const a=process.argv,i=a.indexOf('--port'),p=i>=0?Number(a[i+1]):7100;http.createServer((q,r)=>{const f=path.join(process.cwd(),q.url==='/'?'index.html':q.url.split('?')[0]);fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);r.end('Not found')}else{r.setHeader('Content-Type',f.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream');r.end(d)}})}).listen(p,'0.0.0.0',()=>console.log('EMBER LOOP preview on port '+p))\" --"
  }
}
