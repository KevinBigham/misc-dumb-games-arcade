+export const FIRST_NAMES = ['Marcus', 'James', 'Devin', 'Caleb', 'Andre', 'Tyler', 'Isaiah', 'Jordan', 'Malik', 'Derek', 'Evan', 'Travis', 'Jalen', 'Cameron', 'Miles', 'Cole', 'Darius', 'Brandon', 'Elijah', 'Troy', 'Julian', 'Nolan', 'Dominic', 'Aaron', 'Xavier', 'Blake', 'Dante', 'Wesley', 'Jamal', 'Grant', 'Bryce', 'Landon'];
+export const LAST_NAMES = ['Mitchell', 'Carter', 'Reynolds', 'Brooks', 'Hayes', 'Bennett', 'Jackson', 'Marshall', 'Sullivan', 'Williams', 'Foster', 'Coleman', 'Reed', 'Porter', 'Harrison', 'Walker', 'Davis', 'Watkins', 'Palmer', 'Ellis', 'Freeman', 'Robinson', 'Knight', 'Murray', 'Lawson', 'Banks', 'Henderson', 'Vaughn', 'Pierce', 'Monroe', 'Wallace', 'Jefferson'];
+export const COLLEGES = ['Great Lakes State', 'Pacific Tech', 'Northern Illinois', 'Coastal State', 'Central Texas', 'Western Valley', 'Mountain State', 'Ohio Central', 'Southern California', 'East Carolina', 'Midwest State', 'Florida Atlantic'];
