+  }
+  .hero-badge span {
+    font-size:17px
+  }
+  .hero-content {
+    padding-left:18px
+  }
+  .hero-bottom {
+    padding:0 18px
+  }
+  .hero-bottom>span {
+    font-size:5px
+  }
+  .hero-bottom button {
+    font-size:6px
+  }
+  .hero-record span {
+    font-size:6px
+  }
+  .hero-record strong {
+    font-size:20px
+  }
+  .hero-divider {
+    margin:0 3px
+  }
+  .metric {
+    padding:13px
+  }
+  .metric-icon {
+    display:none
+  }
+  .metric>strong {
+    font-size:22px
+  }
